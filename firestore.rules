// ============================================================
// اختياري: قواعد أمان Firestore
// ============================================================
// لما تعمل الداتابيز أول مرة وتختار "Start in test mode"، التطبيق
// هيشتغل على طول من غير أي خطوة تانية لمدة 30 يوم.
// بعد الـ 30 يوم، Firestore هيوقف القراءة/الكتابة. لو حصل كده:
//
// 1. روح Firebase Console > Firestore Database > تبويب Rules
// 2. امسح اللي موجود، والصق اللي تحت بدله
// 3. دوس Publish
//
// (نفس فكرة test mode، بس من غير تاريخ انتهاء)
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
